# Browser-exposed variables (VITE_ prefix required)
# These are safe to expose to the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────
# TEST / SERVER ONLY — NEVER expose to the browser
# ──────────────────────────────────────────────────────────────
# Do NOT prefix with VITE_. Do NOT reference via import.meta.env.
# Only use via process.env in Node test scripts, Edge Functions,
# or server-side code. Never commit the actual key value.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets (configured in Supabase dashboard, NOT in browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

AI_PROVIDER=openai
EMBEDDING_PROVIDER=openai

CHAT_MODEL=
EXTRACTION_MODEL=
REFLECTION_MODEL=
EMBEDDING_MODEL=

APP_URL=
